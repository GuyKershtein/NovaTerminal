<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NovaTerminal.App.Views.MainWindow"
        Title="NovaTerminal"
        Width="960" Height="600"
        MinWidth="320" MinHeight="200"
        Background="#11131A">

  <DockPanel>
    <Border x:Name="StatusBar"
            DockPanel.Dock="Bottom"
            Padding="10,4"
            Background="#181B24">
      <TextBlock x:Name="StatusText"
                 FontFamily="Cascadia Mono,Consolas,monospace"
                 FontSize="11"
                 Foreground="#8A91A5" />
    </Border>

    <!-- The terminal surface is added here in code: it is a custom-drawn control that needs its
         engine and theme injected, which XAML cannot supply. -->
    <Border x:Name="TerminalHost" Padding="6" />
  </DockPanel>
</Window>
